import { test, expect } from '@playwright/test';

//Sekcja konfiguracji danych

const APP_URL = 'http://localhost:3000/login';
const LOGIN = 'LOGIN_UŻYTKOWNIKA';
const PASS = 'HASŁO_UŻYTKOWNIKA';

//Grupa testowa i automatyczne logowanie

test.describe('Zarządzanie panelem reklamowym', () => {

    // Ten kod wykona się automatycznie przed każdym testem w tej grupie
    test.beforeEach(async ({ page }) => {
        await page.goto(APP_URL);
        await page.getByRole('button', { name: 'Zaloguj się'}).click();

        await page.waitForURL(/.*keycloak.*/);
        await page.getByLabel(/Login domenowy/).fill(LOGIN);
        await page.getByLabel(/Hasło domenowe/).fill(PASS);
        await page.getByRole('button', { name: 'Logowanie'}).click();

        await page.waitForURL(/.*panel-administracyjny*./);
    });

    test('Użytkownik powinien móc się poprawnie wylogowąć', async ({ page }) => {
        await page.getByRole('button', {name: 'JT'}).click();
        await page.getByRole('button', {name: 'Wyloguj się'}).click();
        await page.getByRole('button', {name: 'Wyloguj się'}).click();
        await expect(page).toHaveURL(APP_URL);
    });

    test('Użytkownik pownien móc wyszukać reklamę po nazwie', async ({ page }) => {
        const WYSZUKIWARKA = page.locator('input[type="text"][maxlength="255"]').first(); // UŻYWAM TEGO LOCATORA BO TEST ZNALAZŁ BŁAD W PLACEHOLDERZE
        await WYSZUKIWARKA.fill('test');
        await WYSZUKIWARKA.press('Enter');
        await expect(page.getByText('test').first()).toBeVisible();
        await WYSZUKIWARKA.clear();
    });
});
