import { test, expect } from '@playwright/test';

// Konfiguracja logowania
const APP_URL = 'http://localhost:3000/login';
const LOGIN = 'j.testowy';
const PASS = '1';

test.describe('Smoke Test - Nawigacja po menu głównym', () => {

    test.beforeEach(async ({ page }) => {
        await page.goto(APP_URL);
        await page.getByRole('button', { name: 'Zaloguj się' }).click();

        await page.waitForURL(/.*keycloak.*/);
        await page.getByLabel(/Login domenowy/).fill(LOGIN);
        await page.getByLabel(/Hasło domenowe/).fill(PASS);
        await page.getByRole('button', { name: 'Logowanie' }).click();

        await page.waitForURL(/.*panel-administracyjny.*/);
        
    });

    test('Użytkownik może poprawnie nawigować po wszystkich zakładkach z menu bocznego', async ({ page }) => {

        const zakladkiMenu = [
            { nazwa: 'Reklamy', oczekiwanyUrl: 'reklamy' },
            { nazwa: 'Urządzenia', oczekiwanyUrl: 'urzadzenia' },
            { nazwa: 'Lokalizacje', oczekiwanyUrl: 'lokalizacje', dokladnie: true },
            { nazwa: 'Gabinety', oczekiwanyUrl: 'gabinety' },
            { nazwa: 'Tagi', oczekiwanyUrl: 'tagi' }
        ];

        for (const zakladka of zakladkiMenu) {
            console.log(`Sprawdzam zakładkę: ${zakladka.nazwa}`);

            if (zakladka.dokladnie) {
                await page.getByRole('link', { name: zakladka.nazwa, exact: true }).click();
            } else {
                await page.getByRole('link', { name: zakladka.nazwa }).click();
            }

            await expect(page).toHaveURL(new RegExp(`.*${zakladka.oczekiwanyUrl}.*`));
            await page.waitForTimeout(500);
        }
    });
});
