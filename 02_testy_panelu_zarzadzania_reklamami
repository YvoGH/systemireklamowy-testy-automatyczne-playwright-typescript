import { test, expect } from '@playwright/test';

const APP_URL = process.env.PLAYWRIGHT_APP_URL as string;
const LOGIN = process.env.PLAYWRIGHT_TEST_LOGIN as string;
const PASS = process.env.PLAYWRIGHT_TEST_PASS as string;

test.describe('Zarządzanie panelem reklamowym', () => {
    test.beforeEach(async ({ page }) => {
        await page.goto(APP_URL);
        await page.getByRole('button', { name: 'Zaloguj się' }).click();

        await page.waitForURL(/.*keycloak.*/);
        await page.getByLabel(/Login domenowy/).fill(LOGIN);
        await page.getByLabel(/Hasło domenowe/).fill(PASS);
        await page.getByRole('button', { name: 'Logowanie' }).click();

        await page.waitForURL(/.*panel-administracyjny.*/);
    });

    test('Użytkownik powinien móc wyszukać reklamę po nazwie', async ({ page }) => {
        const WYSZUKIWARKA = page.locator('input[type="text"][maxlength="255"]').first();

        await WYSZUKIWARKA.fill('test');
        await WYSZUKIWARKA.press('Enter');

        await expect(page.getByText('test').first()).toBeVisible();
        await WYSZUKIWARKA.clear();
    });

    test('Użytkownik wybiera ilość kafelków widocznych na stronie = 10 i tyle widać', async ({ page }) => {
        const WSZYSTKIE_KAFELKI = page.getByText(/Aktywna|Wkrótce wygasa/);

        await page.locator('select[name="ilość wyników"]').selectOption('10');

        await expect(page).toHaveURL(/.*pageSize=10.*/);
        await expect(WSZYSTKIE_KAFELKI).toHaveCount(10);
    });

    test('Użytkownik otwiera formularz dodawania reklamy a następnie go zamyka', async ({ page }) => {
        await page.getByRole('button', { name: 'Dodaj nową reklamę' }).click();

        const naglowekModala = page.getByRole('heading', { name: 'Dodaj nową reklamę' });
        await expect(naglowekModala).toBeVisible();

        await page.locator('button:has(.lucide-x)').click();
        await expect(naglowekModala).not.toBeVisible();
    });

    test('Użytkownik powinien móc dodać nową reklamę z plikiem, a następnie ją usunąć', async ({ page }) => {
        const UNIKALNA_NAZWA_REKLAMY = `Reklama_testowa_${Date.now()}`;
        const DATA_DZIS = new Date().toISOString().split('T')[0];
        const dataZaTydzien = new Date();
        dataZaTydzien.setDate(dataZaTydzien.getDate() + 7);
        const DATA_ZA_TYDZIEN = dataZaTydzien.toISOString().split('T')[0];

        await page.getByRole('button', { name: 'Dodaj nową reklamę'}).click();

        await page.setInputFiles('input[type="file"]', 'testy_playwright_pliki_do_testów/logo_luxmed.jpg');
        await page.getByRole('button', { name: 'Dalej' }).click();

        await page.getByPlaceholder('Wprowadź nazwę...').fill(UNIKALNA_NAZWA_REKLAMY);

        await page.getByLabel('Aktywna od').fill(DATA_DZIS);
        await page.getByLabel('Aktywna do').fill(DATA_ZA_TYDZIEN);

        await page.getByRole('button', { name: 'Dalej' }).click();
        await page.getByRole('button', { name: 'Dodaj reklamy' }).click();
        await page.getByRole('button', { name: 'Przypisz' }).click();

        const TOAST_SUKCESU = page.getByText('Utworzono 1 reklamę').first();
        await expect(TOAST_SUKCESU).toBeVisible();
        await page.getByTestId('next-step').click();

        await page.waitForTimeout(1000);
        await page.mouse.move(0, 0);
        await page.waitForTimeout(1000);
        await page.mouse.move(500, 500);
        await page.waitForTimeout(1000);

        await expect(TOAST_SUKCESU).toBeHidden();

        const wyszukiwarka = page.locator('input[type="text"][maxlength="255"]').first();
        await wyszukiwarka.fill(UNIKALNA_NAZWA_REKLAMY);
        await wyszukiwarka.press('Enter');

        const NOWY_KAFELEK = page.getByText(UNIKALNA_NAZWA_REKLAMY).first();
        await expect(NOWY_KAFELEK).toBeVisible();
        await NOWY_KAFELEK.click();

        await page.waitForTimeout(1000);

        await page.getByTestId('ad-delete').click();

        await page.getByTestId('dialog-confirm').click();

        const toastSukcesUsuniecia = page.locator('.Toastify__toast--success');
        await expect(toastSukcesUsuniecia).toContainText('Usunięto pomyślnie');
        await toastSukcesUsuniecia.getByLabel('close').click();

        await expect(toastSukcesUsuniecia).toBeHidden();
        await expect(NOWY_KAFELEK).not.toBeVisible();
    });
});
