import { test, expect } from '@playwright/test';
import crypto from 'crypto';
import 'dotenv/config';

const APP_URL = process.env.PLAYWRIGHT_APP_URL as string;
const LOGIN = process.env.PLAYWRIGHT_TEST_LOGIN as string;
const PASS = process.env.PLAYWRIGHT_TEST_PASS as string;

test.describe('Słowniki - Tagi (CRUD)', () => {

    test.beforeEach(async ({ page }) => {
        await page.goto(APP_URL);
        await page.getByRole('button', { name: 'Zaloguj się' }).click();
        await page.getByLabel(/Login domenowy/).fill(LOGIN);
        await page.getByLabel(/Hasło domenowe/).fill(PASS);
        await page.getByRole('button', { name: 'Logowanie' }).click();

        await page.waitForURL(/.*panel-administracyjny.*/);

        await page.getByRole('link', { name: 'Tagi', exact: true }).click();
        await expect(page).toHaveURL(/.*tagi.*/);
    });

    test.describe.serial('Cykl życia statusu tagu', () => {

        test('Wyszukiwanie wybranego tagu i jego dezaktywacja', async ({ page }) => {
            const wybranyTag = 'Placówki lubelskie';
            await page.getByPlaceholder('Nazwa tagu...').fill(wybranyTag);
            await page.waitForTimeout(2500);

            const docelowyWiersz = page.getByRole('row', { name : wybranyTag});
            await expect(docelowyWiersz).toBeVisible();

            await docelowyWiersz.getByLabel('Dezaktywuj', { exact: true }).click();

            const modalPotwiedzeniaDezaktywacji = page.getByRole('dialog');
            await modalPotwiedzeniaDezaktywacji.getByRole('button', { name: 'Dezaktywuj', exact: true}).click();
            await expect(modalPotwiedzeniaDezaktywacji).toBeHidden()

            const toastDezaktywacji = page.locator('.Toastify__toast');
            await expect(toastDezaktywacji).toContainText(/tag/i);
            await toastDezaktywacji.getByLabel('close').click();
            await expect(toastDezaktywacji).toBeHidden();
        });

        test('Wyszukanie wybranego tagu i jego aktywacja', async ({ page }) => {
            const wybranyTag = 'Placówki lubelskie';
            await page.getByPlaceholder('Nazwa tagu...').fill(wybranyTag);
            await page.waitForTimeout(2500);

            const docelowyWiersz = page.getByRole('row', { name: wybranyTag});
            await expect(docelowyWiersz).toBeVisible();

            await docelowyWiersz.getByLabel('Aktywuj', { exact: true }).click();

            const modalPotwiedzeniaAktywacji = page.getByRole('dialog');
            await modalPotwiedzeniaAktywacji.getByRole('button', { name: 'Aktywuj', exact: true}).click();
            await expect(modalPotwiedzeniaAktywacji).toBeHidden()

            const toastAktywacji = page.locator('.Toastify__toast');
            await expect(toastAktywacji).toContainText(/tag/i);
            await toastAktywacji.getByLabel('close').click();
            await expect(toastAktywacji).toBeHidden();
        });
    });
});
